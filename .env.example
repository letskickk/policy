# OpenAI API 키 (필수). https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=

# 접근제어 (내부 정책 도구)
# ADMIN_EMAILS=admin@example.com,admin2@example.com
# SESSION_SECRET=랜덤문자열-프로덕션에서-반드시-변경
# 이메일 인증: 1=활성화 시 가입 후 인증 메일 발송, 인증 완료 후 로그인 가능
# EMAIL_VERIFICATION_ENABLED=1
# APP_BASE_URL=https://yoursite.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=앱비밀번호
# FROM_EMAIL=noreply@yoursite.com
# QUOTA_DAILY=30
# QUOTA_MONTHLY=300
# RATE_LIMIT_IP_PER_MIN=30
# RATE_LIMIT_USER_PER_MIN=10
# CACHE_TTL_HOURS=24

# 사용할 모델 (기본값 gpt-5.2). 리포트(verify)=CHAT_MODEL, /check=OPENAI_MODEL
# OPENAI_MODEL=gpt-5.2
# CHAT_MODEL=gpt-5.2

# GPT에 넣는 PDF 전체 텍스트 한도(자). 정강/공약은 각각 절반 사용. 0=무제한(전부 로드, GPT 토큰 한도만 따름)
# MAX_CONTEXT_CHARS=150000
# MAX_CONTEXT_CHARS=0

# PDF 추출: pdfplumber(기본, 로컬/AWS 동일 출력 권장) | pypdf | auto
# PDF_EXTRACTOR=pdfplumber

# AWS: 인덱스 캐시 경로. Linux 기본값 /tmp/index_cache는 재시작 시 휘발 → 영구 경로 지정 필요
# INDEX_CACHE_DIR=/app/data/index_cache

# 임베딩: text-embedding-3-large(3072차원) | text-embedding-3-small(1536차원). 모델 변경 시 차원도 일치
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSION=3072

# 프로덕션: /api/debug/* 비활성화 (0=비활성)
# DEBUG_ENDPOINTS_ENABLED=0

# OpenAI Vector Store 사용 (1=FAISS 대신, AWS 인프라 단순화)
# USE_OPENAI_VECTOR_STORE=1
# 서버 시작 시 ingest는 실행되지 않음. 반드시 scripts/ingest_vector_store.py로 사전 인덱싱.
# Vector Store ID (기본은 .rag/registry.json 우선, .env는 fallback)
# OPENAI_VECTOR_STORE_ID=vs_xxx
# OPENAI_REGIONAL_VECTOR_STORE_ID=vs_yyy
# file_search 결과 개수. full=6, quick phase=3 (속도 우선)
# FILE_SEARCH_MAX_RESULTS=6
# FILE_SEARCH_MAX_RESULTS_QUICK=3
