# OpenAI API 키 (필수). https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=

# 사용할 모델 (기본값 gpt-5.2). 리포트(verify)=CHAT_MODEL, /check=OPENAI_MODEL
# OPENAI_MODEL=gpt-5.2
# CHAT_MODEL=gpt-5.2

# PDF 추출: pdfplumber(기본, 로컬/AWS 동일 출력 권장) | pypdf | auto
# PDF_EXTRACTOR=pdfplumber

# AWS: 인덱스 캐시 경로. Linux 기본값 /tmp/index_cache는 재시작 시 휘발 → 영구 경로 지정 필요
# INDEX_CACHE_DIR=/app/data/index_cache

# 임베딩: text-embedding-3-large(3072차원) | text-embedding-3-small(1536차원). 모델 변경 시 차원도 일치
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSION=3072

# 프로덕션: /api/debug/* 비활성화 (0=비활성)
# DEBUG_ENDPOINTS_ENABLED=0

# OpenAI Vector Store 사용 (1=FAISS 대신, AWS 인프라 단순화. 1GB 무료, 초과 시 $0.10/GB/day)
# Responses API file_search 사용 → gpt-5.2 등 최신 모델 지원
# USE_OPENAI_VECTOR_STORE=1
# 재사용 시 (서버 재시작 시 재생성 방지):
# OPENAI_VECTOR_STORE_ID=vs_xxx
