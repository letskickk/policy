{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "strategy_mode",
    "round_goal",
    "priorities",
    "generator_prompt"
  ],
  "properties": {
    "strategy_mode": {
      "type": "string",
      "enum": ["narrow", "breakthrough"]
    },
    "round_goal": {
      "type": "string"
    },
    "priorities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tier",
          "title",
          "action",
          "files"
        ],
        "properties": {
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "title": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "generator_prompt": {
      "type": "string"
    }
  }
}
